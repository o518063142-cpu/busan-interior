rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Consultations Collection Security Rules
    match /consultations/{consultationId} {
      // Unauthenticated visitors can create consultation applications
      allow create: if true;

      // Only authenticated admin users can read, update, or delete consultations
      allow read, update, delete: if request.auth != null;
    }

    // Anonymous conversion funnel events.
    // No name, phone number, or free-text customer details are stored here.
    match /conversionEvents/{eventId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'eventName',
          'path',
          'source',
          'sessionId',
          'utmSource',
          'utmMedium',
          'utmCampaign',
          'referrer',
          'createdAt'
        ]) &&
        request.resource.data.eventName is string &&
        request.resource.data.path is string &&
        request.resource.data.source is string &&
        request.resource.data.sessionId is string;

      // Funnel data is visible only to signed-in admin users.
      allow read, update, delete: if request.auth != null;
    }

    // Projects Collection Security Rules
    match /projects/{projectId} {
      // Public visitors can read projects
      allow read: if true;

      // Only authenticated admin users can create, update, or delete projects
      allow create, update, delete: if request.auth != null;
    }
  }
}
