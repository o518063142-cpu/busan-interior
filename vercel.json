{
  "functions": {
    "api/*.ts": {
      "includeFiles": "api/**"
    }
  },

  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    }
  ],

  "redirects": [
    {
      "source": "/information/busanjin-remodeling-checklist",
      "destination": "/information/busan-interior-remodeling-checklist",
      "statusCode": 301
    }
  ],

  "routes": [
    {
      "src": "/api/upload-ai-estimate-file/?$",
      "dest": "/api/ai-estimate?mode=upload"
    },
    {
      "src": "/api/ai-leads/?$",
      "dest": "/api/funnel-metrics?mode=leads"
    },
    {
      "src": "/api/ai-estimate-attachment/?$",
      "dest": "/api/funnel-metrics?mode=attachment"
    },
    {
      "src": "/admin/ai-leads/?$",
      "dest": "/index.html"
    },
    {
      "src": "/admin/funnel/?$",
      "dest": "/index.html"
    },
    {
      "src": "/admin/?$",
      "dest": "/index.html"
    },
    {
      "src": "/service/?$",
      "dest": "/api/render-service"
    },
    {
      "src": "/projects/?$",
      "dest": "/api/render-listing?page=projects"
    },
    {
      "src": "/projects/([^/]+)/?$",
      "dest": "/api/render-project?slug=$1"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/information/([^/]+)/?$",
      "dest": "/api/render-information?slug=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/render-listing?page=home"
    }
  ]
}
